# INZO environment configuration — copy to .env and adjust.
# Rule 5: API keys are never hard-coded. Rule 14: .env stays out of Git.

INZO_ENV=development
INZO_LOG_LEVEL=INFO
INZO_DATA_DIR=./data
INZO_HOST=127.0.0.1
INZO_PORT=8000

# Model routing. "local-echo" is the built-in deterministic local adapter
# (no network, no key). Other adapters are configured by name only —
# providers are never hard-coded (Rule 4).
INZO_LLM_PROVIDER=local-echo

# Voice pipeline confidence gate: below this, INZO asks the speaker to
# repeat instead of fabricating a transcript.
INZO_STT_CONFIDENCE_THRESHOLD=0.6

# Optional provider keys (leave empty for fully local operation):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
